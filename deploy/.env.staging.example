# Copy to ~/exohaven-staging/.env and fill in (chmod 600 .env).
# Use NEW random values, not production's: generate each with `openssl rand -base64 32`
# (APP_KEYS takes two, comma-separated). Do not add IMAGEKIT_* keys here.

# Image tag to test, e.g. sha-1a2b3c4 from a PR merge. "main" = latest main build.
STRAPI_TAG=main

POSTGRES_USER=strapi_user
POSTGRES_PASSWORD=
POSTGRES_DB=strapi_db

APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
